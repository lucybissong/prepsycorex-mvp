generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Submission {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  phone       String
  pathway     String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}
